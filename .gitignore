# Build output
bin/
obj/
dist*/
.vs/
*.user
*.suo

# Optional character artwork is local-only. app.ico is the only distributable
# file in Resources; this also keeps generated sheets and archives out of Git.
/Resources/*
!/Resources/app.ico

# Credential-shaped data must never be committed. The app only ever READS the
# CLIs' own files from the user profile; nothing of the sort belongs in here.
# Scoped to data files on purpose — a bare *credential* glob also swallows
# source like Services/CredentialRefresher.cs.
*.credentials.json
.credentials.json
auth.json
settings.json
secrets.json
appsettings.*.json
*.pem
*.key
*.pfx
*.p12
*.env
.env*
*token*.json
*credential*.json
*credentials*.txt
