<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TokenNotchWin</AssemblyName>
    <RootNamespace>TokenNotchWin</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <IncludeLocalPetAssets Condition="'$(IncludeLocalPetAssets)' == ''">true</IncludeLocalPetAssets>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- These ignored, local-only packs are embedded when present. Public clones
       build normally with no match and fall back to the bundled Clawd pet. -->
  <ItemGroup Condition="'$(IncludeLocalPetAssets)' == 'true'">
    <Resource Include="Resources\pixel-*-actions\*\atlas.png" />
    <Resource Include="Resources\pixel-*-actions\*\manifest.json" />
  </ItemGroup>

  <!-- WinForms is referenced only for the tray icon; its implicit global usings
       collide with WPF's Brush/Color/Size everywhere else. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
